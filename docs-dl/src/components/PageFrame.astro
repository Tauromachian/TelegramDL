---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageFrame.astro';
import Footer from './Footer.astro';
---

<div class="page-layout-wrapper">
    <Default {...Astro.props}>
        <slot name="header" slot="header" />
        <slot name="sidebar" slot="sidebar" />
        <slot />
    </Default>
    <Footer />
</div>

<style>
    .page-layout-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        position: relative;
    }

    /* Override Starlight container positioning to clear the layout correctly */
    .page-layout-wrapper :global(.main-frame) {
        padding-bottom: 0 !important;
    }

    .page-layout-wrapper :global(.page) {
        flex: 1;
    }

    /* Bring custom footer above structural boundaries and clear lines */
    :global(.custom-footer) {
        position: relative;
        z-index: 10;
        margin-top: auto;
    }
</style>
